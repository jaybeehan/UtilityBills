# Copy to .env and fill in. Never commit .env.

# sync = sync now, then every day at RUN_HOUR (what the container normally runs)
# One-off modes are run from the command line instead (see README):
#   capture = log in once and save pages, once = sync a single time
MODE=sync
RUN_HOUR=7
DRY_RUN=true

# Lacombe Utilities spreadsheet
SHEET_ID=1bo1mBDDxPsKPg5e8BMskq0rOWWfD4Ye9cG4zSN3-KQY

ECHO_USERNAME=
ECHO_PASSWORD=

LACOMBE_USERNAME=
LACOMBE_PASSWORD=

